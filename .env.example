# Copy to .env and fill in. .env is gitignored.

# Viam machine credentials (Viam app -> machine -> CONNECT -> API keys)
VIAM_API_KEY=
VIAM_API_KEY_ID=

# Machine address and camera component name. Defaults in table_scan.py match
# the armfarm15 machine, so these are only needed to point elsewhere.
VIAM_ADDRESS=armfarm15-main.310sld03v2.viam.cloud
VIAM_CAMERA=cam

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Only needed if your API key is not scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
